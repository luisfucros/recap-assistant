{
  "id": null,
  "uid": "recap-ingestion-pipeline",
  "title": "Recap — Ingestion Pipeline",
  "description": "Celery task throughput/duration, document ingestion outcomes, outbox queue depth, and process resource usage for the ingestion worker.",
  "tags": ["recap"],
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Task rate by outcome",
      "description": "sum(rate(recap_ingestion_task_seconds_count[5m])) by (task, outcome) — Celery task throughput.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(recap_ingestion_task_seconds_count{job=\"ingestion\"}[5m])) by (task, outcome)",
          "legendFormat": "{{task}} ({{outcome}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Task duration (p95) by task",
      "description": "histogram_quantile(0.95, ...) over recap_ingestion_task_seconds — how long each Celery task takes.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(recap_ingestion_task_seconds_bucket{job=\"ingestion\"}[5m])) by (le, task))",
          "legendFormat": "{{task}} p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Documents ingested, by outcome",
      "description": "sum(rate(recap_documents_ingested_total[5m])) by (outcome) — indexed vs. failed, over time.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(recap_documents_ingested_total{job=\"ingestion\"}[5m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Chunks per indexed document (p50 / p95)",
      "description": "histogram_quantile over recap_document_chunks — corpus size distribution.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(recap_document_chunks_bucket{job=\"ingestion\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(recap_document_chunks_bucket{job=\"ingestion\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox backlog (ingestion queue depth)",
      "description": "recap_outbox_pending — unprocessed transactional-outbox events, refreshed each relay tick. The RecapIngestionQueueBacklog alert fires above 100 for 10m.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "recap_outbox_pending{job=\"ingestion\"}",
          "legendFormat": "pending events"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "rate(process_cpu_seconds_total[5m]) — fraction of one core consumed by the worker process.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"ingestion\"}[5m])",
          "legendFormat": "cores"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "description": "process_resident_memory_bytes — the worker process's resident memory.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"ingestion\"}",
          "legendFormat": "RSS"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
