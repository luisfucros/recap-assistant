# ---------------------------------------------------------------------------
# recap — example environment file.
#
# Copy to `.env` (never commit `.env`) and adjust. The defaults below are wired
# for `docker compose up`: hostnames are compose service names (postgres, qdrant,
# redis, minio, ...). If you instead run a service directly on your host (e.g.
# `uv run uvicorn`), swap those hosts for `localhost` and use the published ports.
#
# Placeholders shown as `changeme` / empty values are NOT real secrets — fill
# them in locally. Optional integrations (Google OAuth, hosted LLM/embeddings,
# web search, Langfuse) can be left blank; the stack still boots.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=recap
# local | dev | test | prod  (prod fails fast if security-critical vars are unset)
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Force-build heavy singletons (embedding model) and open DB/Redis/Qdrant pools at
# startup so the first request isn't slow. Set false for a faster boot in dev/CI.
WARM_UP_ON_START=true
# Default spoiler-safe setting for new users: when on, retrieval/summaries are
# hard-bounded to already-read pages. Users can override globally/per-book/per-query.
SPOILER_SAFE_DEFAULT=true

# --- Auth / security --------------------------------------------------------
# Generate a long random string, e.g. `openssl rand -hex 32`. Required in prod.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Cookies are set with Secure in prod (HTTPS). Keep false for local http dev.
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax
# Comma-separated allowed browser origins (no wildcard in prod).
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Bootstrap admin (optional) ----------------------------------------------
# Seeds one admin user via a one-time, idempotent data migration (the `migrate`
# container). Leave both blank to skip seeding — safe to leave set permanently.
INITIAL_ADMIN_EMAIL=admin_recap@mail.com
INITIAL_ADMIN_PASSWORD=recap_admin_pass

# --- Google OAuth (optional) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the browser is sent after a successful OAuth login (the SPA).
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL -------------------------------------------------------------
# App connection string (async driver). Host `postgres` = compose service name.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/recap
# Credentials consumed by the `postgres` compose service (keep in sync with the URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recap

# --- Qdrant (vector DB) -----------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_CHUNKS_COLLECTION=document_chunks
QDRANT_MEMORY_COLLECTION=long_term_memory

# --- Redis / Celery ---------------------------------------------------------
# DB 0 = cache/sessions, DB 1 = Celery broker (separate logical DBs).
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Port the ingestion worker serves its Prometheus /metrics on.
INGESTION_METRICS_PORT=9808
# Port the eval Celery worker serves its Prometheus /metrics on.
EVAL_METRICS_PORT=9809
# Re-enqueue a pending/running evaluation run older than this (seconds).
EVAL_STUCK_THRESHOLD_SECONDS=900
EVAL_SWEEP_INTERVAL_SECONDS=60

# --- Uploads ----------------------------------------------------------------
# Max size (bytes) of an uploaded document, enforced at the API boundary. 50 MiB.
MAX_UPLOAD_BYTES=52428800

# --- Object storage (S3 / MinIO) --------------------------------------------
# Leave S3_ENDPOINT_URL set for MinIO (local); unset it to target real AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=recap
S3_REGION=us-east-1
# Root credentials consumed by the `minio` compose service (keep in sync above).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- LLM provider -----------------------------------------------------------
# anthropic | openai | ollama  (fully-local: set to `ollama`, no key needed)
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint for the local Ollama profile (also used by the
# Ollama vision/embedding providers).
OLLAMA_BASE_URL=http://ollama:11434/v1
# Leave blank for a local install (any string works; a placeholder is used).
# Set to a real key — together with pointing OLLAMA_BASE_URL at Ollama Cloud's
# endpoint — to run hosted, larger Llama models through the same client.
OLLAMA_API_KEY=
# Per-tier model id overrides; unset uses the provider's built-in default (e.g.
# anthropic: claude-sonnet-5 / claude-haiku-4-5-20251001).
LLM_MODEL=
LLM_MODEL_CHEAP=
# Resilience: retry attempts on transient LLM errors, and an ordered CSV of
# providers to fall back to if the primary keeps failing (e.g. "openai,ollama").
LLM_MAX_RETRIES=2
LLM_FALLBACK_PROVIDERS=

# --- Agent compaction ---------------------------------------------------------
# Per-provider context windows (tokens) and the fraction of it at which a
# session auto-compacts (history summarized, checkpoint rewritten, count reset).
LLM_CONTEXT_WINDOW_ANTHROPIC=200000
LLM_CONTEXT_WINDOW_OPENAI=400000
LLM_CONTEXT_WINDOW_OLLAMA=128000
COMPACTION_THRESHOLD_RATIO=0.75

# --- Retrieval --------------------------------------------------------------
# Default number of chunks a semantic search returns (before near-duplicate
# collapse). Retrieval always filters by the authenticated user and defaults to
# the read range (page_end <= current page) for a targeted document.
RETRIEVAL_TOP_K=8

# --- Analytics --------------------------------------------------------------
# Seconds a user's computed reading analytics (pace/streak/pages-over-time) are
# cached in Redis before recompute.
ANALYTICS_CACHE_TTL_SECONDS=300
# Seconds a user's computed usage summary (token spend/tool-call counts) is
# cached in Redis before recompute.
USAGE_CACHE_TTL_SECONDS=300

# --- Agent scratchpad -------------------------------------------------------
# TTL (seconds) for the agent's turn-scoped working memory in Redis (plan /
# findings / open-questions). Short — it's ephemeral per-turn notes.
SCRATCHPAD_TTL_SECONDS=1800

# --- Embeddings -------------------------------------------------------------
# openai | voyage | huggingface | ollama  (fully-local: `huggingface` (on-box, no
# key) or `ollama` (over OLLAMA_BASE_URL, no key, no torch — `ollama pull
# nomic-embed-text` first); huggingface loads its own model in-process, ollama
# reuses the same OpenAI-compatible client as the local LLM/vision providers)
EMBEDDINGS_PROVIDER=huggingface
# openai: text-embedding-3-small | huggingface: e.g. BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Ollama embedding model id (e.g. nomic-embed-text, mxbai-embed-large).
EMBEDDING_MODEL_LOCAL=nomic-embed-text
# Chunks embedded per batch — bound memory / avoid OOM on local models.
EMBED_BATCH_SIZE=20
VOYAGE_API_KEY=

# --- Multimodal input (FR-19) -----------------------------------------------
# Audio→text and image→text for chat attachments, behind pluggable providers so
# the whole chat path can run fully hosted or fully local (like embeddings).
# openai (hosted; reuses OPENAI_API_KEY) | huggingface (local, offline via transformers)
TRANSCRIPTION_PROVIDER=huggingface
# hosted model id (openai) — the local option uses TRANSCRIPTION_MODEL_LOCAL instead
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_MODEL_LOCAL=openai/whisper-base
# openai (hosted vision) | ollama (local vision model over OLLAMA_BASE_URL, no key,
# no torch — same OpenAI-compatible client as the local LLM; `ollama pull gemma4` first)
VISION_PROVIDER=openai
VISION_MODEL=gpt-4.1-mini
VISION_MODEL_LOCAL=gemma4:latest
# Max size (bytes) of a single decoded chat attachment (audio clip / image). 15 MiB.
CHAT_MEDIA_MAX_BYTES=15728640

# --- Ingestion pipeline -----------------------------------------------------
# Structure-aware chunk window + overlap, in whitespace-delimited words.
CHUNK_SIZE_WORDS=512
CHUNK_OVERLAP_WORDS=64
# Outbox relay (Celery beat): poll cadence (seconds) and events dispatched/tick.
OUTBOX_RELAY_INTERVAL_SECONDS=5.0
OUTBOX_RELAY_BATCH_SIZE=100
# Transient-failure retries for an ingestion task before it's marked failed.
INGEST_MAX_RETRIES=3

# --- Web search (HITL-gated) ------------------------------------------------
# brave | tavily
WEB_SEARCH_PROVIDER=tavily
BRAVE_API_KEY=
TAVILY_API_KEY=

# --- Rate limiting (Redis-backed, shared across API replicas) ---------------
# Auth (register/login/refresh) is capped per client IP; chat (a turn-triggering
# route) is capped per authenticated user.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# --- Langfuse (OPTIONAL tracing) --------------------------------------------
# Leave all three empty to disable tracing (no-op); the app runs identically.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Grafana (metrics dashboards) -------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
